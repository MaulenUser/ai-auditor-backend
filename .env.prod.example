POSTGRES_DB=ai_auditor
POSTGRES_USER=ai_auditor
POSTGRES_PASSWORD=change_me_to_a_long_random_password

AI_AUDITOR_AUTH_SECRET=change_me_to_a_long_random_secret
SETUP_INTEGRATIONS_TOKEN=change_me_to_a_long_random_setup_token
AI_AUDITOR_JOB_STALE_SECONDS=7200

# Bitrix24 OAuth app credentials.
# BITRIX_APPLICATION_TOKEN is optional but recommended for install/uninstall callback verification.
BITRIX_OAUTH_CLIENT_ID=
BITRIX_OAUTH_CLIENT_SECRET=
BITRIX_APPLICATION_TOKEN=

# Local test: 8080. Production behind a domain can use 80.
FRONTEND_PORT=8080
